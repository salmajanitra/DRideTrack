# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CARTO_API_KEY: Optional Carto basemaps API key from carto.com/basemaps
# When provided, automatically appended as ?api_key=... to Carto Dark & Voyager tile requests.
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_CARTO_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
# Used by @vis.gl/react-google-maps for cycling navigation, satellite layers, and AdvancedMarkers.
VITE_GOOGLE_MAPS_API_KEY=""

# STRAVA_CLIENT_ID: Your Strava API Application Client ID
# Obtain from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""

# STRAVA_CLIENT_SECRET: Your Strava API Application Client Secret
# Obtain from https://www.strava.com/settings/api
STRAVA_CLIENT_SECRET=""

